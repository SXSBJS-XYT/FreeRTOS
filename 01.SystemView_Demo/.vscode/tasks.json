{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make",
            "args": ["-j8"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": []
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": ["Clean", "Build"]
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "problemMatcher": [],
            "dependsOn": ["Build"]
        }
    ]
}
